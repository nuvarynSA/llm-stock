# Groq API key — required. Create a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Model used for the tool-calling loop (optional).
# Default is a tool-capable model on Groq's free tier.
GROQ_MODEL=openai/gpt-oss-120b

# Optional comma-separated fallback list (tried in order on rate limit):
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile

# HTTP port the demo listens on (optional).
PORT=3000
